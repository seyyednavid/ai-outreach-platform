# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored. Never commit real keys.

# PostgreSQL started by compose.yaml (local-only password).
# Use 127.0.0.1, not localhost: on Windows "localhost" may try IPv6 first
# and stall for several seconds on every new connection.
DATABASE_URL=postgresql+psycopg://outreach:local_dev_password@127.0.0.1:5433/outreach_db

# OpenAI API key used by all agents: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Google OAuth client (type "Web application") for creating Gmail drafts.
# In Google Cloud Console, add GOOGLE_REDIRECT_URI as an authorised
# redirect URI exactly as written here. Without Gmail, keep the
# placeholders: the app still runs, only "Connect Gmail" will fail.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/gmail/callback

# Optional: database used by pytest. It must be called outreach_test_db,
# and the tests drop its tables when they finish.
# TEST_DATABASE_URL=postgresql+psycopg://outreach:local_dev_password@127.0.0.1:5433/outreach_test_db

# Login (Supabase Auth). Project URL only, without /rest/v1.
# The backend checks tokens with the project's public keys, so no
# Supabase secret key is needed here.
SUPABASE_URL=https://your-project-ref.supabase.co

# Your existing data goes to the first account that signs in with this email.
LEGACY_OWNER_EMAIL=you@example.com

# Encrypts Gmail tokens in the database. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Tracing: every draft is one trace in https://platform.openai.com/traces
# Set to false in production: traces then keep timing and structure but
# not prompts or outputs (email text, names).
TRACE_INCLUDE_SENSITIVE_DATA=true

# Prices for the cost estimate, in US dollars per million tokens.
# Defaults are for gpt-4.1-mini; update them if the model or prices change.
# LLM_INPUT_PRICE_PER_MILLION=0.40
# LLM_OUTPUT_PRICE_PER_MILLION=1.60

# Product owners (comma-separated). Only these accounts see the Usage
# page with tokens, costs and traces for every customer.
ADMIN_EMAILS=you@example.com
