# Copy to terraform.tfvars (git-ignored) and adjust if needed:
#   cp terraform.tfvars.example terraform.tfvars
# Never put secrets (API keys, passwords) in .tfvars files.

project_id = "ai-outreach-platform-demo"
region     = "europe-west2"

# Backend image to deploy: the tag pushed to Artifact Registry
# (git rev-parse --short=12 HEAD at build time).
backend_image_tag = "13f88479cfae"

# gcloud projects describe ai-outreach-platform-demo --format="value(projectNumber)"
project_number = "123456789012"

# Backend settings that are not secret (secrets live in Secret Manager).
google_client_id = "1234567890-abc.apps.googleusercontent.com"
supabase_url     = "https://your-project-ref.supabase.co"
admin_emails     = "you@example.com"

# Frontend image to deploy: the tag pushed to Artifact Registry.
# Replace after building (git rev-parse --short=12 HEAD at build time).
frontend_image_tag = "not-built-yet"

# GitHub repository allowed to deploy (gh api repos/OWNER/REPO --jq ".id, .owner.id").
github_repository    = "your-account/ai-outreach-platform"
github_repository_id = "123456789"
github_owner_id      = "12345678"
